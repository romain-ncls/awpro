#!/bin/sh
set -e

# Apply the udev rule to a headset that is already plugged in. Tolerate
# failure: udevd is not running in containers or chroots.
if [ "$1" = "configure" ] && command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=hidraw --action=change || true
fi
